{
  "name": "@n0y/degen-trainingsbuch",
  "version": "1.0.0",
  "description": "= Degen - Trainingsbuch",
  "main": "index.js",
  "dependencies": {
    "asciidoctor-kroki": "^0.18.1"
  },
  "devDependencies": {
    "@antora/cli": "3.2.2",
